{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MIND",
  "scopeName": "source.mind",
  "fileTypes": ["mind"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mind",
          "match": "(///)(?!/).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.mind" }
          }
        },
        {
          "name": "comment.line.double-slash.mind",
          "match": "(//).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.mind" }
          }
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.mind",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.mind" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.mind" }
      },
      "patterns": [{ "include": "#block-comment" }]
    },
    "attributes": {
      "name": "meta.attribute.mind",
      "begin": "(#)(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.mind" },
        "2": { "name": "punctuation.brackets.attribute.begin.mind" },
        "3": { "name": "entity.other.attribute-name.mind" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.brackets.attribute.end.mind" }
      },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#punctuation" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mind",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.mind" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.mind" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.mind",
          "match": "\\\\[ntr0\\\\'\"]"
        },
        {
          "name": "invalid.illegal.unknown-escape.mind",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.mind",
      "match": "(')(?:(\\\\[ntr0\\\\'\"])|[^'\\\\])(')",
      "captures": {
        "1": { "name": "punctuation.definition.string.begin.mind" },
        "2": { "name": "constant.character.escape.mind" },
        "3": { "name": "punctuation.definition.string.end.mind" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.mind",
          "match": "\\b0[xX][0-9a-fA-F_]+(usize|isize|u8|u16|u32|u64|i8|i16|i32|i64)?\\b",
          "captures": {
            "1": { "name": "storage.type.numeric.mind" }
          }
        },
        {
          "name": "constant.numeric.integer.octal.mind",
          "match": "\\b0[oO][0-7_]+(usize|isize|u8|u16|u32|u64|i8|i16|i32|i64)?\\b",
          "captures": {
            "1": { "name": "storage.type.numeric.mind" }
          }
        },
        {
          "name": "constant.numeric.integer.binary.mind",
          "match": "\\b0[bB][01_]+(usize|isize|u8|u16|u32|u64|i8|i16|i32|i64)?\\b",
          "captures": {
            "1": { "name": "storage.type.numeric.mind" }
          }
        },
        {
          "name": "constant.numeric.float.mind",
          "match": "\\b[0-9]+(?:_[0-9]+)*\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.mind",
          "match": "\\b[0-9]+(?:_[0-9]+)*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.mind",
          "match": "\\b[0-9]+(?:_[0-9]+)*(usize|isize|u8|u16|u32|u64|i8|i16|i32|i64)?\\b",
          "captures": {
            "1": { "name": "storage.type.numeric.mind" }
          }
        }
      ]
    },
    "imports": {
      "match": "\\b(import|use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:(?:\\.|::)[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.import.mind" },
        "2": { "name": "entity.name.namespace.mind" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.mind" },
            "2": { "name": "entity.name.function.mind" }
          }
        },
        {
          "match": "\\b(struct|enum|trait|type|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.mind" },
            "2": { "name": "entity.name.type.mind" }
          }
        },
        {
          "match": "\\b(module|invariant)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.mind" },
            "2": { "name": "entity.name.namespace.mind" }
          }
        },
        {
          "match": "(?<!\\*)\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.const.mind" },
            "2": { "name": "variable.other.constant.mind" }
          }
        },
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.let.mind" },
            "2": { "name": "storage.modifier.mut.mind" },
            "3": { "name": "variable.other.mind" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mind",
          "match": "\\b(if|else|match|for|in|while|loop|return|break|continue)\\b"
        },
        {
          "name": "keyword.control.import.mind",
          "match": "\\b(import|use|export)\\b"
        },
        {
          "name": "keyword.other.as.mind",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.function.mind",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.mind",
          "match": "\\b(let|const|struct|enum|type|trait|impl|module|extern|invariant)\\b"
        },
        {
          "name": "storage.modifier.mind",
          "match": "\\b(pub|mut|unsafe)\\b"
        },
        {
          "name": "storage.modifier.mind",
          "match": "\\bsafe(?=\\s+fn\\b)|\\bdiff(?=\\s+tensor\\b)"
        },
        {
          "name": "keyword.other.mind",
          "match": "\\b(assert|where|defer)\\b"
        },
        {
          "name": "keyword.other.mind",
          "match": "\\bregion(?=\\s*\\{)|\\bcallconv(?=\\s*\\()|\\bsparse(?=\\s*\\[)"
        },
        {
          "name": "constant.language.boolean.mind",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.mind",
          "match": "\\bself\\b"
        },
        {
          "name": "entity.name.type.self.mind",
          "match": "\\bSelf\\b"
        },
        {
          "name": "support.constant.prelude.mind",
          "match": "\\b(Some|None|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.mind",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f16|bf16|f32|f64|q16|bool)\\b"
        },
        {
          "name": "storage.type.tensor.mind",
          "match": "\\b(tensor|Tensor)\\b"
        },
        {
          "name": "support.type.prelude.mind",
          "match": "\\b(Option|Result|String)\\b"
        },
        {
          "name": "support.type.collection.mind",
          "match": "\\b(map|set|array)(?=\\s*<)"
        },
        {
          "name": "variable.other.constant.mind",
          "match": "\\b[A-Z]{2,}(?:[0-9]+)?(?:_[A-Z0-9]+)*\\b"
        },
        {
          "name": "entity.name.type.mind",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mind",
          "match": "\\b(print|grad)(?=\\s*\\()"
        },
        {
          "name": "support.function.intrinsic.mind",
          "match": "\\b__mind_[A-Za-z0-9_]+\\b"
        },
        {
          "name": "entity.name.function.call.mind",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.mind",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.mind",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.variadic.mind",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.mind",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.elementwise.mind",
          "match": "\\.[-+*/]"
        },
        {
          "name": "keyword.operator.assignment.compound.mind",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.comparison.mind",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.mind",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.shift.mind",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.mind",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.mind",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.matmul.mind",
          "match": "@"
        },
        {
          "name": "keyword.operator.arithmetic.mind",
          "match": "[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.mind",
          "match": "[&|^]"
        },
        {
          "name": "keyword.operator.try.mind",
          "match": "\\?"
        },
        {
          "name": "punctuation.accessor.mind",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.mind",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.mind",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.mind",
          "match": ":"
        },
        {
          "name": "punctuation.brackets.round.mind",
          "match": "[()]"
        },
        {
          "name": "punctuation.brackets.square.mind",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.brackets.curly.mind",
          "match": "[{}]"
        }
      ]
    }
  }
}
